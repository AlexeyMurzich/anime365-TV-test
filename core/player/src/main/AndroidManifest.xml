<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Разрешение по умолчанию: 720p на мобильной сети, 1080p по Wi-Fi. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Плеер держит процессор и Wi-Fi, пока играет с выключенным экраном (WAKE_MODE_NETWORK). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application>
        <!--
            Фоновый звук, уведомление и гарнитура (ADR 0008). Экспортирован без разрешения, как
            требует Media3: к сессии подключаются системные контроллеры — уведомление, Bluetooth.
        -->
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
