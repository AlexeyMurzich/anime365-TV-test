<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+. Резервная копия переживает переустановку, поэтому смягчает ADR 0001
    (Библиотека только на устройстве). Файл Токена доступа обязан быть исключён, как только
    появится (M2): его ключ шифрования в Keystore в копию не попадает, и восстановленный
    файл не расшифровать.
-->
<data-extraction-rules>
    <cloud-backup />
    <device-transfer />
</data-extraction-rules>
