<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+. Резервная копия переживает переустановку, поэтому смягчает ADR 0001
    (Библиотека только на устройстве): library.db в неё входит.
    datastore/account.preferences_pb — Токен доступа: его ключ шифрования в Keystore в копию не
    попадает, и восстановленный файл не расшифровать (ADR 0005).
    cache.db — кэш данных сайта: он восстанавливается с сервера и в копии только занимает место.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/account.preferences_pb" />
        <exclude domain="database" path="cache.db" />
        <exclude domain="database" path="cache.db-shm" />
        <exclude domain="database" path="cache.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/account.preferences_pb" />
        <exclude domain="database" path="cache.db" />
        <exclude domain="database" path="cache.db-shm" />
        <exclude domain="database" path="cache.db-wal" />
    </device-transfer>
</data-extraction-rules>
